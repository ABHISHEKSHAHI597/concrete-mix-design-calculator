# Copy to .env and adjust. All values are optional.

# Public path the app is served from.
#   ./        relative, works at any path (default)
#   /         domain root
#   /repo/    GitHub Pages project site
BASE_PATH=./

# Interface to bind. Use 0.0.0.0 to expose on the network or inside Docker.
HOST=localhost

# Port for `npm run dev`
PORT=5173

# Port for `npm run preview`
PREVIEW_PORT=4173
